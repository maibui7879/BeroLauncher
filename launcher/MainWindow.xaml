<Window
  x:Class="StellaViet.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="BeroLauncher"
  Icon="pack://application:,,,/stella-sora-icon.ico"
  Width="1180"
  Height="760"
  MinWidth="980"
  MinHeight="620"
  WindowStartupLocation="CenterScreen"
>
  <Grid Background="#F5F5EF">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="88" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Background="#203D33">
      <Grid Margin="12,22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Width="48" Height="48" Background="#D7E9C3" CornerRadius="12">
          <TextBlock
            Text="B"
            Foreground="#203D33"
            FontSize="30"
            FontWeight="SemiBold"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
          />
        </Border>
        <Button
          x:Name="LibraryButton"
          Grid.Row="1"
          Click="Home"
          ToolTip="Launcher"
          AutomationProperties.Name="Launcher"
          Background="#426052"
          Foreground="White"
          BorderThickness="0"
          Margin="0,32,0,0"
          VerticalAlignment="Top"
          Padding="6,12"
        >
          <StackPanel>
            <Path
              Style="{StaticResource Icon}"
              Data="{StaticResource Icon.Grid}"
              HorizontalAlignment="Center"
            />
            <TextBlock
              Text="Launcher"
              TextWrapping="NoWrap"
              FontSize="10"
              Margin="0,8,0,0"
              HorizontalAlignment="Center"
            />
          </StackPanel>
        </Button>
        <Button
          Grid.Row="2"
          Click="OpenSettings"
          ToolTip="Cài đặt"
          AutomationProperties.Name="Cài đặt"
          Background="Transparent"
          BorderThickness="0"
          Foreground="#DFE8DE"
          Margin="0"
        >
          <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Settings}" />
        </Button>
      </Grid>
    </Border>
    <Grid x:Name="MainShell" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="80" />
        <RowDefinition Height="*" MinHeight="200" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" MinHeight="136" />
      </Grid.RowDefinitions>
      <Grid Margin="30,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="BeroLauncher" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="Launcher" Foreground="#526859" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
        <Button
          Grid.Column="1"
          Click="OpenSettings"
          Background="Transparent"
          BorderThickness="0"
          Margin="0"
          VerticalAlignment="Center"
        >
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Settings}" />
            <TextBlock Text="Cài đặt" Margin="9,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <Grid Grid.Row="1" Margin="24,0" ClipToBounds="True" Background="#E2EBDD">
        <Viewbox Stretch="UniformToFill" HorizontalAlignment="Right" IsHitTestVisible="False">
          <Canvas Width="1000" Height="540" ClipToBounds="True">
            <Rectangle Width="1000" Height="540" Fill="#E2EBDD" />
            <Ellipse Width="390" Height="390" Canvas.Left="590" Canvas.Top="-110" Fill="#EDF2DE" />
            <Path
              Fill="#CEDACD"
              Data="M 290,540 L 420,390 520,408 660,275 760,295 850,215 1000,300 1000,540 Z"
            />
            <Path
              Fill="#A9BDB0"
              Data="M 450,540 L 450,413 510,370 510,540 M 570,540 L 570,280 600,230 630,280 630,540 M 750,540 L 750,340 780,290 810,340 810,540 M 900,540 L 900,200 930,150 960,200 960,540"
            />
            <Path
              Fill="#809E8C"
              Data="M 630,540 L 630,470 700,430 700,540 M 820,540 L 820,440 865,415 865,540"
            />
            <Path
              Fill="#F9FBEF"
              Data="M 600,260 L 604,280 622,284 604,288 600,310 596,288 578,284 596,280 Z M 930,180 L 933,198 950,202 933,206 930,224 927,206 910,202 927,198 Z"
            />
          </Canvas>
        </Viewbox>
        <StackPanel
          Margin="36,34,28,34"
          VerticalAlignment="Bottom"
          HorizontalAlignment="Left"
          MaxWidth="440"
        >
          <TextBlock
            Text="STELLA SORA"
            FontSize="13"
            FontWeight="Medium"
            Foreground="#45634E"
            Margin="0,0,0,10"
          />
          <TextBlock Text="Stella Sora" FontSize="50" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Border Background="#F0F5E9" Padding="10,5" CornerRadius="4">
              <TextBlock
                x:Name="LanguageState"
                Text="Đang kiểm tra ngôn ngữ"
                FontSize="12"
                Foreground="#3C5B48"
              />
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>
      <Border
        x:Name="UpdateCard"
        Grid.Row="2"
        Visibility="Collapsed"
        Background="#E8EFE2"
        BorderBrush="#C5D3BB"
        BorderThickness="1"
        CornerRadius="6"
        Padding="18,14"
        Margin="24,16,24,0"
      >
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Path
            Data="{StaticResource Icon.Download}"
            Width="23"
            Height="23"
            Stretch="Uniform"
            Stroke="#2E684B"
            StrokeThickness="1.7"
            VerticalAlignment="Center"
            Margin="0,0,16,0"
          />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="Có bản Việt hóa mới" FontWeight="SemiBold" />
            <TextBlock
              Text="Cập nhật để nhận những bản dịch mới nhất."
              Foreground="#526859"
              FontSize="12"
              Margin="0,4,0,0"
            />
          </StackPanel>
          <Button
            x:Name="UpdateButton"
            Grid.Column="2"
            Click="UpdateClick"
            VerticalAlignment="Center"
            Margin="0"
          >
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Download}" />
              <TextBlock
                x:Name="UpdateLabel"
                Text="Cập nhật"
                Margin="9,0,0,0"
                VerticalAlignment="Center"
              />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
      <StackPanel Grid.Row="3" Margin="30,18,30,0">
        <Label
          Content="Vị trí cài game"
          Target="{Binding ElementName=HomeGamePath}"
          Padding="0"
          FontWeight="Medium"
          Margin="0,0,0,8"
        />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox
            x:Name="HomeGamePath"
            Text="{Binding Text, ElementName=GamePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsEnabled="{Binding IsEnabled, ElementName=GamePath}"
            AutomationProperties.Name="Vị trí cài game"
            FontSize="12"
            VerticalContentAlignment="Center"
            ToolTip="Nhập đường dẫn tới thư mục chứa StellaSora.exe. Chuyển về tiếng Anh trước khi đổi thư mục khi có phiên Việt hóa đang bật."
          />
          <Button
            Grid.Column="1"
            Click="ChooseGame"
            IsEnabled="{Binding IsEnabled, ElementName=BrowseButton}"
            Margin="12,0,0,0"
          >
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Folder}" />
              <TextBlock Text="Chọn thư mục" Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock
          Text="{Binding Text, ElementName=PathHint}"
          Foreground="#526859"
          FontSize="12"
          Margin="0,8,0,0"
          AutomationProperties.LiveSetting="Polite"
        />
      </StackPanel>
      <Grid Grid.Row="4" Margin="30,20,30,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="230" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,26,0">
          <TextBlock x:Name="GameStatus" Text="Chưa chọn game" FontSize="16" FontWeight="Medium" />
          <TextBlock
            x:Name="Status"
            Text="Chọn game trong Cài đặt để bắt đầu."
            Foreground="#526859"
            Margin="0,7,0,0"
            FontSize="13"
            AutomationProperties.LiveSetting="Polite"
          />
          <ProgressBar
            x:Name="Progress"
            Height="4"
            Margin="0,12,0,0"
            Visibility="Collapsed"
            Foreground="#2E684B"
          />
          <WrapPanel Margin="0,16,0,0">
            <Button
              x:Name="LauncherUpdateButton"
              Click="LauncherUpdateClick"
              Visibility="Collapsed"
              Margin="0,0,10,8"
              Padding="12,10"
              ToolTip="Tải bản launcher mới đã xác minh. Phiên Việt hóa sẽ được khôi phục trước khi cập nhật."
            >
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Refresh}" />
                <TextBlock
                  x:Name="LauncherUpdateLabel"
                  Text="Cập nhật launcher"
                  Margin="9,0,0,0"
                  VerticalAlignment="Center"
                />
              </StackPanel>
            </Button>
            <Button
              Click="UpdateLanguageClick"
              IsEnabled="{Binding IsEnabled, ElementName=CheckUpdatesButton}"
              ToolTip="Kiểm tra và cài gói ngôn ngữ mới nhất. Hãy đóng game trước khi cập nhật."
              Padding="12,10"
              Margin="0,0,10,8"
            >
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Refresh}" />
                <TextBlock
                  x:Name="LanguageUpdateLabel"
                  Text="Cập nhật gói ngôn ngữ"
                  Margin="9,0,0,0"
                  VerticalAlignment="Center"
                />
              </StackPanel>
            </Button>
            <Button
              Click="Restore"
              IsEnabled="{Binding IsEnabled, ElementName=RestoreButton}"
              ToolTip="Tắt Việt hóa và khôi phục bản tiếng Anh. Hãy đóng game trước khi đổi."
              Padding="12,10"
              Margin="0,0,0,8"
            >
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Undo}" />
                <TextBlock
                  Text="{Binding Text, ElementName=RestoreLabel}"
                  Margin="9,0,0,0"
                  VerticalAlignment="Center"
                />
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>
        <Button
          x:Name="PlayButton"
          Grid.Column="1"
          Click="Play"
          FontSize="16"
          FontWeight="SemiBold"
          Height="60"
          Background="#2E684B"
          Foreground="White"
          BorderThickness="0"
          Margin="0"
          VerticalAlignment="Center"
        >
          <StackPanel Orientation="Horizontal">
            <Path
              Style="{StaticResource Icon}"
              Data="{StaticResource Icon.Play}"
              Width="21"
              Height="21"
              Fill="White"
              StrokeThickness="0"
            />
            <TextBlock
              x:Name="PlayLabel"
              Text="Chơi ngay"
              Margin="13,0,0,0"
              VerticalAlignment="Center"
            />
          </StackPanel>
        </Button>
      </Grid>
    </Grid>
    <Grid
      x:Name="SettingsPanel"
      KeyboardNavigation.TabNavigation="Cycle"
      Grid.ColumnSpan="2"
      Visibility="Collapsed"
      Background="#780E2019"
    >
      <Border Background="#FAFBF6" Width="530" Padding="30" HorizontalAlignment="Right">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Cài đặt" FontSize="26" FontWeight="SemiBold" />
              <TextBlock Text="Stella Sora" Foreground="#526859" FontSize="13" Margin="0,5,0,0" />
            </StackPanel>
            <Button
              x:Name="CloseSettingsButton"
              Grid.Column="1"
              Click="Home"
              Width="44"
              Padding="12"
              Margin="0"
              AutomationProperties.Name="Đóng cài đặt"
              ToolTip="Đóng (Esc)"
              VerticalAlignment="Top"
            >
              <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Close}" />
            </Button>
          </Grid>
          <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
          >
            <StackPanel>
              <Label
                Content="Vị trí cài game"
                Target="{Binding ElementName=GamePath}"
                Padding="0"
                FontWeight="SemiBold"
                Margin="0,0,0,10"
              />
              <TextBox
                x:Name="GamePath"
                TextChanged="PathChanged"
                AutomationProperties.Name="Vị trí cài game"
                FontSize="12"
              />
              <TextBlock
                x:Name="PathHint"
                Text="Chọn thư mục đã cài Stella Sora."
                Foreground="#526859"
                FontSize="12"
                Margin="0,9,0,12"
              />
              <Button
                x:Name="BrowseButton"
                Click="ChooseGame"
                HorizontalAlignment="Left"
                Margin="0,0,0,28"
              >
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Folder}" />
                  <TextBlock Text="Chọn thư mục" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border BorderBrush="#D5DDD1" BorderThickness="0,1,0,0" Padding="0,24,0,0">
                <StackPanel>
                  <TextBlock Text="Ngôn ngữ" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock
                    x:Name="ReleaseInfo"
                    Foreground="#526859"
                    Margin="0,10,0,16"
                    FontSize="13"
                  />
                  <Button
                    x:Name="CheckUpdatesButton"
                    Click="CheckUpdatesClick"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0,8"
                    Margin="0,0,0,20"
                  >
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Refresh}" />
                      <TextBlock
                        x:Name="CheckLabel"
                        Text="Kiểm tra cập nhật"
                        Margin="9,0,0,0"
                        VerticalAlignment="Center"
                      />
                    </StackPanel>
                  </Button>
                  <WrapPanel>
                    <Button
                      x:Name="InstallButton"
                      Click="Install"
                      Background="#2E684B"
                      Foreground="White"
                      BorderThickness="0"
                      Margin="0,0,10,10"
                    >
                      <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Globe}" />
                        <TextBlock
                          x:Name="InstallLabel"
                          Text="Bật Việt hóa"
                          Margin="9,0,0,0"
                          VerticalAlignment="Center"
                        />
                      </StackPanel>
                    </Button>
                    <Button x:Name="RestoreButton" Click="Restore" Margin="0,0,0,10">
                      <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Undo}" />
                        <TextBlock
                          x:Name="RestoreLabel"
                          Text="Dùng tiếng Anh"
                          Margin="9,0,0,0"
                          VerticalAlignment="Center"
                        />
                      </StackPanel>
                    </Button>
                  </WrapPanel>
                  <TextBlock
                    Text="Đóng game và launcher Yostar trước khi thay đổi ngôn ngữ."
                    FontSize="12"
                    Foreground="#526859"
                    Margin="0,8,0,0"
                  />
                </StackPanel>
              </Border>
              <Border Background="#EAF0E5" Padding="14" CornerRadius="5" Margin="0,24,0,0">
                <TextBlock
                  x:Name="SettingsStatus"
                  Text="Bản dịch mới được cập nhật riêng với launcher."
                  Foreground="#3E5848"
                  FontSize="13"
                  AutomationProperties.LiveSetting="Polite"
                />
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Border
            Grid.Row="2"
            BorderBrush="#D5DDD1"
            BorderThickness="0,1,0,0"
            Padding="0,18,0,0"
            Margin="0,22,0,0"
          >
            <StackPanel>
              <TextBlock
                Text="Đóng cửa sổ để chạy nền. Thoát launcher sẽ khôi phục tiếng Anh sau khi game đóng."
                Foreground="#526859"
                FontSize="12"
                Margin="0,0,0,12"
              />
              <DockPanel>
                <TextBlock
                  Text="BeroLauncher 0.4.6"
                  Foreground="#526859"
                  FontSize="12"
                  VerticalAlignment="Center"
                />
                <Button
                  Content="Thoát launcher"
                  Click="ExitLauncher"
                  HorizontalAlignment="Right"
                  Margin="12,0,0,0"
                />
              </DockPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
