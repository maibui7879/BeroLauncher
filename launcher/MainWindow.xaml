<Window x:Class="StellaViet.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BeroLauncher" Width="1120" Height="760" MinWidth="900" MinHeight="680">
<Grid Background="#F5F5EF"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="#203D33"><Grid Margin="12,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Width="48" Height="48" Background="#D7E9C3" CornerRadius="12"><TextBlock Text="B" Foreground="#203D33" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
<Button Grid.Row="1" Content="S" Click="Home" ToolTip="Stella Sora" AutomationProperties.Name="Stella Sora" FontSize="22" Background="#426052" Foreground="White" BorderThickness="0" Margin="0,36,0,0" VerticalAlignment="Top"/>
<Button Grid.Row="2" Content="☰" Click="OpenSettings" ToolTip="Cài đặt" AutomationProperties.Name="Cài đặt" Background="Transparent" BorderThickness="0" Foreground="#DFE8DE" Margin="0"/>
</Grid></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition/><RowDefinition Height="144"/></Grid.RowDefinitions>
<DockPanel Margin="32,0"><Button Content="Cài đặt" Click="OpenSettings" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Margin="0"/><TextBlock Text="BeroLauncher" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold"/></DockPanel>
<Grid Grid.Row="1" Margin="20,0" ClipToBounds="True" Background="#E2EBDD">
<Viewbox Stretch="UniformToFill" HorizontalAlignment="Right" IsHitTestVisible="False"><Canvas Width="1000" Height="540" ClipToBounds="True">
<Rectangle Width="1000" Height="540" Fill="#E2EBDD"/><Ellipse Width="390" Height="390" Canvas.Left="590" Canvas.Top="-110" Fill="#EDF2DE"/>
<Path Fill="#CEDACD" Data="M 290,540 L 420,390 520,408 660,275 760,295 850,215 1000,300 1000,540 Z"/>
<Path Fill="#A9BDB0" Data="M 450,540 L 450,413 510,370 510,540 M 570,540 L 570,280 600,230 630,280 630,540 M 750,540 L 750,340 780,290 810,340 810,540 M 900,540 L 900,200 930,150 960,200 960,540"/>
<Path Fill="#809E8C" Data="M 630,540 L 630,470 700,430 700,540 M 820,540 L 820,440 865,415 865,540"/>
<Path Fill="#F9FBEF" Data="M 600,260 L 604,280 622,284 604,288 600,310 596,288 578,284 596,280 Z M 930,180 L 933,198 950,202 933,206 930,224 927,206 910,202 927,198 Z"/>
</Canvas></Viewbox>
<StackPanel Margin="38,38,28,36" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="450"><TextBlock Text="STELLA SORA" FontSize="15" Foreground="#45634E" Margin="0,0,0,10"/><TextBlock Text="Stella Sora" FontSize="52" FontWeight="SemiBold"/><TextBlock Text="Phiên bản PC" FontSize="16" Foreground="#45634E" Margin="0,12,0,0"/></StackPanel>
</Grid>
<Grid Grid.Row="2" Margin="32,20,32,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock x:Name="GameStatus" Text="Chưa chọn game" FontSize="16" FontWeight="Medium"/><TextBlock x:Name="Status" Text="Chọn game trong Cài đặt để bắt đầu." Foreground="#506454" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/><ProgressBar x:Name="Progress" Height="4" Margin="0,12,0,0" Visibility="Collapsed" Foreground="#2E684B"/></StackPanel>
<Button x:Name="PlayButton" Grid.Column="1" Content="Chơi ngay   →" Click="Play" FontSize="20" FontWeight="SemiBold" Height="60" Background="#2E684B" Foreground="White" BorderThickness="0" Margin="0" VerticalAlignment="Center"/>
</Grid></Grid>
<Grid x:Name="SettingsPanel" KeyboardNavigation.TabNavigation="Cycle" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#780E2019">
<Border Background="#FAFBF6" Width="650" Padding="32" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel>
<DockPanel Margin="0,0,0,26"><Button x:Name="CloseSettingsButton" Content="Đóng" Click="Home" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0"/><TextBlock Text="Cài đặt" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
<Label Content="Vị trí cài game" Target="{Binding ElementName=GamePath}" Padding="0" Margin="0,0,0,10"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GamePath" TextChanged="PathChanged" AutomationProperties.Name="Vị trí cài game"/><Button x:Name="BrowseButton" Grid.Column="1" Content="Thay đổi…" Click="ChooseGame" Margin="10,0,0,0"/></Grid>
<TextBlock Text="Chọn thư mục đã cài Stella Sora trên máy của bạn." Foreground="#506454" FontSize="12" Margin="0,10,0,26"/>
<Border BorderBrush="#D5DDD1" BorderThickness="0,1,0,0" Padding="0,24,0,0"><StackPanel><TextBlock Text="Tiếng Việt" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ReleaseInfo" Foreground="#506454" Margin="0,8,0,16"/><WrapPanel><Button x:Name="InstallButton" Content="Bật Việt hóa" Click="Install" Background="#2E684B" Foreground="White" BorderThickness="0"/><Button x:Name="RestoreButton" Content="Tắt Việt hóa" Click="Restore"/></WrapPanel><TextBlock Text="Đóng game và launcher Yostar trước khi thay đổi ngôn ngữ." FontSize="12" Foreground="#506454" Margin="0,14,0,0"/></StackPanel></Border>
<TextBlock x:Name="SettingsStatus" Foreground="#506454" Margin="0,22,0,0" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="BeroLauncher · 0.2.0" Foreground="#506454" FontSize="12" Margin="0,26,0,0"/>
</StackPanel></Border></Grid>
</Grid></Window>

