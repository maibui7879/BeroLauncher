<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>BeroLauncher</AssemblyName>
    <Product>BeroLauncher</Product>
    <Version>0.4.6</Version>
    <ApplicationIcon>stella-sora-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- Match the imports available to source files linked by the test project. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="update-public-key.pem" LogicalName="BeroLauncher.UpdateKey" />
    <EmbeddedResource
      Include="launcher-update.ps1"
      LogicalName="BeroLauncher.LauncherUpdateScript"
    />
    <Resource Include="stella-sora-icon.ico" />
    <EmbeddedResource Include="stella-sora-icon.ico" LogicalName="BeroLauncher.LauncherIcon" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="../ui/fonts/Lexend.ttf" Link="Fonts/Lexend.ttf" />
    <Content
      Include="../ui/fonts/OFL-Lexend.txt"
      Link="OFL-Lexend.txt"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
