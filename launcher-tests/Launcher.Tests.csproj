<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../launcher/Services/*.cs" LinkBase="Services" />
    <Compile Include="../launcher/Models/*.cs" LinkBase="Models" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource
      Include="../launcher/update-public-key.pem"
      LogicalName="BeroLauncher.UpdateKey"
    />
  </ItemGroup>
</Project>
